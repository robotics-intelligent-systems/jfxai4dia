" /></mxCell><mxCell id="ST" value="HG-SIM-ST&lt;br&gt;Estructura y uniones&lt;br&gt;Desplazamiento [m], tensiones [Pa], reacciones" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="490" y="890" width="410" height="150" as="geometry" /></mxCell><mxCell id="CT" value="HG-SIM-CT&lt;br&gt;Control / sensado&lt;br&gt;Error de seguimiento, detección y respuesta degradada" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="970" y="890" width="410" height="150" as="geometry" /></mxCell><mxCell id="e0" value="parámetros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="cad" target="MB"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="parámetros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="cad" target="RT"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="parámetros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="cad" target="WI"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="parámetros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="cad" target="FD"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="parámetros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="cad" target="EN"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="parámetros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="cad" target="TH"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="parámetros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="cad" target="ST"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="parámetros" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="cad" target="CT"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="magnitudes / paso acordado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="RT" target="FD"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="magnitudes / paso acordado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="WI" target="FD"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="magnitudes / paso acordado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="FD" target="ST"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="magnitudes / paso acordado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="EN" target="TH"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="magnitudes / paso acordado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="CT" target="FD"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="escenarios" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="mission" target="FD"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="HG-science-1" name="exp [HG] Campaña y dominio"><mxGraphModel dx="1440" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1010" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="exp [HG] Campaña y dominio" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="Revisión C propuesta · 2026-10-11 · Relaciones planificadas; ningún requisito cerrado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="inputs" value="Entradas: CAD dimensionado, propiedades, mapa propulsivo, masa/CG, misión; todos versionados. Invalidar corrida si unidades, ejes o entradas faltan." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="660" height="210" as="geometry" /></mxCell><mxCell id="coupling" value="Acoplamiento: resolver energía, fuerzas y dinámica con paso Δt TBD; F/M en marco B, estados en I; iterar si interacción fuerte. Registrar residuales de potencia y fuerza." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="750" y="190" width="660" height="210" as="geometry" /></mxCell><mxCell id="convergence" value="Verificación numérica: refinamiento de malla y Δt, conservación, tolerancia solver; repetir sensibilidad. Fallo de convergencia no es cumplimiento." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="470" width="660" height="210" as="geometry" /></mxCell><mxCell id="validate" value="Validación: banco rotor/propulsor, pesaje/CG y cargas; AG añade flotación; HG añade rotor–ala e híbrido; EV añade batería y asignación. Datos independientes." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="750" y="470" width="660" height="210" as="geometry" /></mxCell><mxCell id="uq" value="Incertidumbre: barrer masas, coeficientes, eficiencia, ambiente y fallos; separar incertidumbre física y numérica. Métrica RMSE/unidad y cobertura/domain TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="750" width="660" height="210" as="geometry" /></mxCell><mxCell id="gate" value="Aceptación: evidencia por R/V y revisión humana; requisitos de factores humanos, mantenimiento y seguridad exigen actividades adicionales. Todos pendientes." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="750" y="750" width="660" height="210" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="inputs" target="coupling"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="coupling" target="convergence"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="convergence" target="validate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="validate" target="uq"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="uq" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="hybrid-gyrodyne-refs" name="ref · Principios teóricos y capacitación"><mxGraphModel grid="1" page="1" pageWidth="1440" pageHeight="1600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ref · Principios teóricos y capacitación"  style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=17;fillColor=#dae8fc;strokeColor=#536878;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="70" as="geometry"/></mxCell><mxCell id="REF-SYSML" value="REF-SYSML: OMG SysML 1.7&lt;br&gt;req, bdd, ibd, act y par; asignaciones y verificación planificadas.&lt;br&gt;https://www.omg.org/spec/SysML/1.7/" link="https://www.omg.org/spec/SysML/1.7/" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=17;fillColor=#dae8fc;strokeColor=#536878;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="1380" height="150" as="geometry"/></mxCell><mxCell id="REF-ROTOR" value="REF-ROTOR: NASA NDARC theory (2016)&lt;br&gt;Dinámica y teoría de rotor; seleccionar régimen y capítulo antes de implementar. AG/HG: RT/FD; EV: MC/FD.&lt;br&gt;https://ntrs.nasa.gov/api/citations/20160012474/downloads/20160012474.pdf" link="https://ntrs.nasa.gov/api/citations/20160012474/downloads/20160012474.pdf" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=17;fillColor=#dae8fc;strokeColor=#536878;" vertex="1" parent="1"><mxGeometry x="30" y="320" width="1380" height="150" as="geometry"/></mxCell><mxCell id="REF-LIFT" value="REF-LIFT: NASA Glenn: lift equation&lt;br&gt;HG-SIM-WI: L=ρ V² S C_L/2; coeficientes requieren datos y régimen.&lt;br&gt;https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/lift-equation/" link="https://www1.grc.nasa.gov/beginners-guide-to-aeronautics/lift-equation/" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=17;fillColor=#dae8fc;strokeColor=#536878;" vertex="1" parent="1"><mxGeometry x="30" y="510" width="1380" height="150" as="geometry"/></mxCell><mxCell id="REF-BUOY" value="REF-BUOY: OpenStax: Arquímedes&lt;br&gt;AG-SIM-HY: peso del fluido desplazado; no demuestra estabilidad ni oleaje.&lt;br&gt;https://openstax.org/books/university-physics-volume-1/pages/14-4-archimedes-principle-and-buoyancy" link="https://openstax.org/books/university-physics-volume-1/pages/14-4-archimedes-principle-and-buoyancy" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=17;fillColor=#dae8fc;strokeColor=#536878;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="1380" height="150" as="geometry"/></mxCell><mxCell id="REF-BAT" value="REF-BAT: Modelica Standard Library 4.0.0: Batteries&lt;br&gt;EN/TH: modelos equivalentes eléctricos y térmicos; referencia, no dependencia instalada.&lt;br&gt;https://doc.modelica.org/Modelica%204.0.0/Resources/helpDymola/Modelica_Electrical_Batteries_UsersGuide.html" link="https://doc.modelica.org/Modelica%204.0.0/Resources/helpDymola/Modelica_Electrical_Batteries_UsersGuide.html" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=17;fillColor=#dae8fc;strokeColor=#536878;" vertex="1" parent="1"><mxGeometry x="30" y="890" width="1380" height="150" as="geometry"/></mxCell><mxCell id="edu" value="Uso educativo: módulo / requisito → magnitudes y ecuación → dominio y referencia → ejercicio y revisión del instructor. Datos sintéticos, simulados y medidos etiquetados; no capacidad AR implementada."  style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontSize=17;fillColor=#dae8fc;strokeColor=#536878;" vertex="1" parent="1"><mxGeometry x="30" y="1100" width="1380" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
