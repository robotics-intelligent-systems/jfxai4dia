mxGeometry x="440" y="180" width="580" height="85" as="geometry" /></mxCell><mxCell id="a1" value="Inspección y balance híbrido" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="330" width="580" height="85" as="geometry" /></mxCell><mxCell id="a2" value="Rodaje y despegue corto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="480" width="580" height="85" as="geometry" /></mxCell><mxCell id="a3" value="Transición rotor–ala acordada" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="630" width="580" height="85" as="geometry" /></mxCell><mxCell id="a4" value="Crucero y reserva" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="780" width="580" height="85" as="geometry" /></mxCell><mxCell id="a5" value="Aproximación y aterrizaje" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="930" width="580" height="85" as="geometry" /></mxCell><mxCell id="a6" value="Inspección y sustitución modular" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="1080" width="580" height="85" as="geometry" /></mxCell><mxCell id="gate" value="«constraint»&lt;br&gt;Bloqueo: TBD críticos, ICD o datos insuficientes&lt;br&gt;Respuesta degradada debe definirse antes de operar" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="320" height="200" as="geometry" /></mxCell><mxCell id="e0" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="HG-5" name="par [HG] Restricciones y binding connectors"><mxGraphModel dx="1440" dy="2105" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="2105" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="par [HG] Restricciones y binding connectors" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="Bindings sin flecha representan igualdad de valores, no dirección causal. Ecuaciones de cribado; detalles y dominio en docs/simulation." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="iMB" value="«valueProperty»&lt;br&gt;m_i [kg], r_i [m], inercia J [kg m²]; configuración y estados de consumo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="340" height="195" as="geometry" /></mxCell><mxCell id="cMB" value="«constraintProperty» HG-SIM-MB&lt;br&gt;Masa y centrado&lt;br&gt;m = Σ m_i; r_CG = Σ(m_i r_i)/m" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="180" width="520" height="195" as="geometry" /></mxCell><mxCell id="oMB" value="«valueProperty»&lt;br&gt;m [kg], CG [m], J [kg m²]&lt;br&gt;Pesaje y medición de CG independientes; incertidumbre de masas y posiciones; límites TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="195" as="geometry" /></mxCell><mxCell id="iRT" value="«valueProperty»&lt;br&gt;Ω [rad/s], par [N m], geometría, polar y régimen TBC" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="340" height="195" as="geometry" /></mxCell><mxCell id="cRT" value="«constraintProperty» HG-SIM-RT&lt;br&gt;Rotor / propulsor&lt;br&gt;J_r dΩ/dt = Q_drive + Q_aero − Q_loss; T,Q = mapas(Ω,V,ρ,paso)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="420" width="520" height="195" as="geometry" /></mxCell><mxCell id="oRT" value="«valueProperty»&lt;br&gt;T [N], Q [N m], potencia QΩ [W]&lt;br&gt;Autorrotación: Q_drive=0 tras prerrotación; equilibrio estable de par por demostrar; no usar estacionario motorizado como prueba de AG." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="420" width="340" height="195" as="geometry" /></mxCell><mxCell id="iWI" value="«valueProperty»&lt;br&gt;ρ [kg/m³], V [m/s], S [m²], coeficientes y estado del rotor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="340" height="195" as="geometry" /></mxCell><mxCell id="cWI" value="«constraintProperty» HG-SIM-WI&lt;br&gt;Rotor–ala–propulsores&lt;br&gt;q = ρ V²/2; L = q S C_L; D = q S C_D; fuerzas = mapas acoplados" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="660" width="520" height="195" as="geometry" /></mxCell><mxCell id="oWI" value="«valueProperty»&lt;br&gt;Sustentación, resistencia, momentos e interferencia&lt;br&gt;Coeficientes dependientes de régimen; estacionario y transición no se resuelven con fórmula de ala aislada." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="660" width="340" height="195" as="geometry" /></mxCell><mxCell id="iFD" value="«valueProperty»&lt;br&gt;F [N], M [N m], viento [m/s], actitud, v [m/s], J; masas congeladas por segmento" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="340" height="195" as="geometry" /></mxCell><mxCell id="cFD" value="«constraintProperty» HG-SIM-FD&lt;br&gt;Dinámica 6-DOF&lt;br&gt;m dv_I/dt = m g_I + R_BI F_B; J dω/dt = M_B − ω × (Jω)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="900" width="520" height="195" as="geometry" /></mxCell><mxCell id="oFD" value="«valueProperty»&lt;br&gt;Trayectorias, aceleración, márgenes y cargas&lt;br&gt;Cuerpo rígido y marco inercial; rotación y cinemática de actitud separadas; validar fuerzas y transición." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="900" width="340" height="195" as="geometry" /></mxCell><mxCell id="iEN" value="«valueProperty»&lt;br&gt;E_b [J], potencias [W], eficiencias y límites; P_b&amp;gt;0 descarga, P_b&amp;lt;0 carga" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1140" width="340" height="195" as="geometry" /></mxCell><mxCell id="cEN" value="«constraintProperty» HG-SIM-EN&lt;br&gt;Potencia y energía&lt;br&gt;dE_b/dt = −P_b; P_gen + P_b = P_load + P_loss" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1140" width="520" height="195" as="geometry" /></mxCell><mxCell id="oEN" value="«valueProperty»&lt;br&gt;Energía, potencia, reserva y consumo&lt;br&gt;Topología y mapas TBD; pérdidas no negativas; energía y temperatura correlacionadas con banco." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1140" width="340" height="195" as="geometry" /></mxCell><mxCell id="iTH" value="«valueProperty»&lt;br&gt;C_th [J/K], T [K], hA [W/K], pérdidas [W]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1380" width="340" height="195" as="geometry" /></mxCell><mxCell id="cTH" value="«constraintProperty» HG-SIM-TH&lt;br&gt;Temperatura equivalente&lt;br&gt;C_th dT/dt = P_heat − hA(T − T_amb)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1380" width="520" height="195" as="geometry" /></mxCell><mxCell id="oTH" value="«valueProperty»&lt;br&gt;Temperatura y margen al límite&lt;br&gt;Modelo térmico concentrado; gradientes, fugas térmicas y propagación fuera de alcance inicial." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1380" width="340" height="195" as="geometry" /></mxCell><mxCell id="iST" value="«valueProperty»&lt;br&gt;M,C,K, propiedades, apoyos, malla y cargas [N]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1620" width="340" height="195" as="geometry" /></mxCell><mxCell id="cST" value="«constraintProperty» HG-SIM-ST&lt;br&gt;Estructura y uniones&lt;br&gt;M_s ü + C_s u̇ + K_s u = f(t)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1620" width="520" height="195" as="geometry" /></mxCell><mxCell id="oST" value="«valueProperty»&lt;br&gt;Desplazamiento [m], tensiones [Pa], reacciones&lt;br&gt;Lineal elástico de cribado; grandes deformaciones, contacto, fatiga y corrosión requieren modelos adicionales." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1620" width="340" height="195" as="geometry" /></mxCell><mxCell id="iCT" value="«valueProperty»&lt;br&gt;Período [s], ruido, latencia, saturación y fallos TBD" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1860" width="340" height="195" as="geometry" /></mxCell><mxCell id="cCT" value="«constraintProperty» HG-SIM-CT&lt;br&gt;Control / sensado&lt;br&gt;y_k = h(x_k) + ε_k; u_k = control(y,modo,referencia)" style="rounded=0;whiteSpace=w