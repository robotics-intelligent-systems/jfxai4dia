<mxfile host="app.diagrams.net" version="24.7.17" compressed="false"><diagram id="HG-0" name="req [HG] Requisitos 1/2"><mxGraphModel dx="1440" dy="1730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1730" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [HG] Requisitos 1/2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="«satisfy» y «verify» expresan intención y plan; fuentes Markdown conservan texto completo y criterios TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="HG-R-01" value="«requirement» HG-R-01&lt;br&gt;El sistema deberá completar los segmentos de la misión de taxi aéreo definida con ocupación, carga útil, duración, alcance, emplazamientos y reserva registrados.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="180" width="560" height="225" as="geometry" /></mxCell><mxCell id="s0" value="«block»&lt;br&gt;HG-M-00&lt;br&gt;&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="195" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-01" value="«testCase» HG-V-01: Sistemas / revisión&lt;br&gt;CONOPS con ocupantes [n], carga [kg], alcance [km], duración [min] y reserva TBD aprobado.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="225" as="geometry" /></mxCell><mxCell id="HG-R-02" value="«requirement» HG-R-02&lt;br&gt;Cada configuración y estado de consumo deberá permanecer dentro de límites de masa y CG aprobados.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="435" width="560" height="225" as="geometry" /></mxCell><mxCell id="s1" value="«block»&lt;br&gt;HG-M-00&lt;br&gt;HG-SIM-MB&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-02" value="«testCase» HG-V-02: Integración / análisis y pesaje&lt;br&gt;MTOM [kg] y envolvente CG [m] TBD cumplidos en todos los casos de misión y módulos.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="435" width="340" height="225" as="geometry" /></mxCell><mxCell id="HG-R-03" value="«requirement» HG-R-03&lt;br&gt;El rotor y el ala deberán proporcionar sustentación y control en los regímenes de potencia y transición seleccionados.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="690" width="560" height="225" as="geometry" /></mxCell><mxCell id="s2" value="«block»&lt;br&gt;HG-M-01&lt;br&gt;HG-SIM-RT, HG-SIM-WI, HG-SIM-FD&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="705" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-03" value="«testCase» HG-V-03: Dinámica de vuelo / análisis y ensayo progresivo&lt;br&gt;Régimen TBC, envolvente [m/s], RPM, viento y distancia de despegue [m] TBD cerrados; modelos correlacionados y evidencia de transición.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="690" width="340" height="225" as="geometry" /></mxCell><mxCell id="HG-R-04" value="«requirement» HG-R-04&lt;br&gt;El sistema energético deberá suministrar la potencia de los segmentos aprobados y su reserva sin exceder límites eléctricos ni térmicos.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="945" width="560" height="225" as="geometry" /></mxCell><mxCell id="s3" value="«block»&lt;br&gt;HG-M-04&lt;br&gt;HG-SIM-EN, HG-SIM-TH&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-04" value="«testCase» HG-V-04: Propulsión / banco y análisis&lt;br&gt;Balance de potencia [kW], energía [kWh], combustible [kg] si aplica, eficiencia y temperatura [K] TBD dentro de límites; curvas y ciclo de misión.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="945" width="340" height="225" as="geometry" /></mxCell><mxCell id="HG-R-05" value="«requirement» HG-R-05&lt;br&gt;La integración ala-propulsores deberá mantener el empuje y la autoridad de control requeridos en estados normales y fallos definidos.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="1200" width="560" height="225" as="geometry" /></mxCell><mxCell id="s4" value="«block»&lt;br&gt;HG-M-03&lt;br&gt;HG-SIM-WI, HG-SIM-CT&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1215" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-05" value="«testCase» HG-V-05: Propulsión y control / banco y simulación&lt;br&gt;Mapa de empuje [N], asimetría, fallos y márgenes TBD satisfechos; interacciones rotor-ala-propulsores evaluadas.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1200" width="340" height="225" as="geometry" /></mxCell><mxCell id="HG-R-06" value="«requirement» HG-R-06&lt;br&gt;Estructura, uniones, cola y tren deberán soportar las cargas de vuelo, vibración y operación terrestre de la configuración aprobada.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="1455" width="560" height="225" as="geometry" /></mxCell><mxCell id="s5" value="«block»&lt;br&gt;HG-M-02&lt;br&gt;HG-SIM-ST&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1470" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-06" value="«testCase» HG-V-06: Estructuras / análisis, inspección y ensayo&lt;br&gt;Cargas [N], momentos [N m], vida y márgenes TBD satisfechos en rotor, ala, módulos y tren; informe de casos.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1455" width="340" height="225" as="geometry" /></mxCell><mxCell id="e0" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s0" target="HG-R-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="HG-V-01" target="HG-R-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s1" target="HG-R-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="HG-V-02" target="HG-R-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s2" target="HG-R-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="HG-V-03" target="HG-R-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s3" target="HG-R-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="HG-V-04" target="HG-R-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s4" target="HG-R-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="HG-V-05" target="HG-R-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s5" target="HG-R-06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="HG-V-06" target="HG-R-06"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="HG-1" name="req [HG] Requisitos 2/2"><mxGraphModel dx="1440" dy="1220" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [HG] Requisitos 2/2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="«satisfy» y «verify» expresan intención y plan; fuentes Markdown conservan texto completo y criterios TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="HG-R-07" value="«requirement» HG-R-07&lt;br&gt;La cabina deberá permitir acceso, sujeción, visibilidad y evacuación de la población de ocupantes aprobada.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="180" width="560" height="225" as="geometry" /></mxCell><mxCell id="s0" value="«block»&lt;br&gt;HG-M-02&lt;br&gt;&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="195" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-07" value="«testCase» HG-V-07: Factores humanos / demostración&lt;br&gt;Ocupación TBC y criterios de accesibilidad, visibilidad y tiempo [s] TBD cumplidos en maqueta.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="225" as="geometry" /></mxCell><mxCell id="HG-R-08" value="«requirement» HG-R-08&lt;br&gt;El sistema de mando deberá supervisar propulsión y energía y ejecutar las respuestas degradadas definidas para los peligros de misión.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="435" width="560" height="225" as="geometry" /></mxCell><mxCell id="s1" value="«block»&lt;br&gt;HG-M-05&lt;br&gt;HG-SIM-CT&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-08" value="«testCase» HG-V-08: Control y seguridad / integración y revisión&lt;br&gt;Latencias [ms], alertas, respuestas y aceptación de riesgos TBD cumplidas; fallos y trazas documentados.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="435" width="340" height="225" as="geometry" /></mxCell><mxCell id="HG-R-09" value="«requirement» HG-R-09&lt;br&gt;La sustitución de módulos deberá preservar identificación, compatibilidad y funcionamiento de la configuración.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="690" width="560" height="225" as="geometry" /></mxCell><mxCell id="s2" value="«block»&lt;br&gt;HG-M-00&lt;br&gt;HG-SIM-MB&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="705" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-09" value="«testCase» HG-V-09: Mantenimiento / inspección y demostración&lt;br&gt;ICD completos, tiempo [min] y herramientas TBD; prueba posterior conforme y nuevo balance de masa/CG.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="690" width="340" height="225" as="geometry" /></mxCell><mxCell id="HG-R-10" value="«requirement» HG-R-10&lt;br&gt;La gemela deberá representar masa, energía, dinámica e interacción rotor-ala-propulsores para cada revisión identificada.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/hybrid-gyrodyne.md"><mxGeometry x="420" y="945" width="560" height="225" as="geometry" /></mxCell><mxCell id="s3" value="«block»&lt;br&gt;HG-M-06&lt;br&gt;HG-SIM-MB, HG-SIM-WI, HG-SIM-FD, HG-SIM-EN&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="300" height="195" as="geometry" /></mxCell><mxCell id="HG-V-10" value="«testCase» HG-V-10: Modelado / correlación y reproducción&lt;br&gt;Error, incertidumbre y dominio TBD satisfechos con datos independientes; COM-R-03 y COM-R-04 cumplidos.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="945" width="340" height="225" as="geometry" /></mxCell><mxCell id="e0" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s0" target="HG-R-07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="HG-V-07" target="HG-R-07"><mxGeom