<mxfile host="app.diagrams.net" version="24.7.17" compressed="false"><diagram id="COM-0" name="req [COM] Requisitos transversales"><mxGraphModel dx="1440" dy="1685" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1685" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [COM] Requisitos transversales" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="Fuente: docs/requirements/README.md. Las relaciones son planificadas; estado propuesto." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="COM-R-01" value="«requirement» COM-R-01&lt;br&gt;Cada configuración deberá enlazar misión, requisitos aplicables y revisión de arquitectura y CAD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="420" y="180" width="560" height="205" as="geometry" /></mxCell><mxCell id="sCOM-R-01" value="«block» Proceso de ingeniería&lt;br&gt;Sistemas " style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="300" height="205" as="geometry" /></mxCell><mxCell id="vCOM-R-01" value="«testCase» Sistemas / COM-V-01: inspección&lt;br&gt;Manifiesto con IDs y revisiones resolubles; ningún requisito aplicable sin asignación y actividad de verificación." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="205" as="geometry" /></mxCell><mxCell id="COM-R-02" value="«requirement» COM-R-02&lt;br&gt;Cada interfaz deberá declarar origen, destino, magnitudes, unidades, ejes, límites, tolerancias y respuesta ante fallo." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="420" y="430" width="560" height="205" as="geometry" /></mxCell><mxCell id="sCOM-R-02" value="«block» Proceso de ingeniería&lt;br&gt;Integración " style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="430" width="300" height="205" as="geometry" /></mxCell><mxCell id="vCOM-R-02" value="«testCase» Integración / COM-V-02: revisión ICD&lt;br&gt;ICD revisado; límites TBD resueltos y prueba de compatibilidad definida antes de integrar." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="430" width="340" height="205" as="geometry" /></mxCell><mxCell id="COM-R-03" value="«requirement» COM-R-03&lt;br&gt;Cada ejecución CAS deberá registrar geometría, malla si aplica, parámetros, hipótesis, versiones, entradas y resultados." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="420" y="680" width="560" height="205" as="geometry" /></mxCell><mxCell id="sCOM-R-03" value="«block» Proceso de ingeniería&lt;br&gt;Modelado " style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="680" width="300" height="205" as="geometry" /></mxCell><mxCell id="vCOM-R-03" value="«testCase» Modelado / COM-V-03: reproducción&lt;br&gt;Segunda ejecución dentro de tolerancia acordada TBD; informe de convergencia y dominio de validez." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="680" width="340" height="205" as="geometry" /></mxCell><mxCell id="COM-R-04" value="«requirement» COM-R-04&lt;br&gt;Los modelos deberán evaluarse con datos de validación identificados y separados de los de calibración." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="420" y="930" width="560" height="205" as="geometry" /></mxCell><mxCell id="sCOM-R-04" value="«block» Proceso de ingeniería&lt;br&gt;V&amp;amp;V " style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="930" width="300" height="205" as="geometry" /></mxCell><mxCell id="vCOM-R-04" value="«testCase» V&amp;amp;V / COM-V-04: análisis&lt;br&gt;Error, incertidumbre y dominio contrastados con límites TBD acordados; datos insuficientes mantienen el modelo sin validar." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="930" width="340" height="205" as="geometry" /></mxCell><mxCell id="COM-R-05" value="«requirement» COM-R-05&lt;br&gt;Las alternativas de IA deberán someterse a los mismos controles de geometría, física y evidencia que las demás alternativas." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="420" y="1180" width="560" height="205" as="geometry" /></mxCell><mxCell id="sCOM-R-05" value="«block» Proceso de ingeniería&lt;br&gt;Sistemas " style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1180" width="300" height="205" as="geometry" /></mxCell><mxCell id="vCOM-R-05" value="«testCase» Sistemas / COM-V-05: auditoría&lt;br&gt;Registro de procedencia y revisión; ningún resultado de IA cierra un requisito sin la verificación asignada." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1180" width="340" height="205" as="geometry" /></mxCell><mxCell id="COM-R-06" value="«requirement» COM-R-06&lt;br&gt;Todo cambio de módulo, parámetro o requisito deberá evaluar impacto en interfaces, masa, modelos y pruebas." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="420" y="1430" width="560" height="205" as="geometry" /></mxCell><mxCell id="sCOM-R-06" value="«block» Proceso de ingeniería&lt;br&gt;Configuración " style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1430" width="300" height="205" as="geometry" /></mxCell><mxCell id="vCOM-R-06" value="«testCase» Configuración / COM-V-06: revisión de cambio&lt;br&gt;Lista de artefactos afectados, pruebas a repetir y decisión de revisión registrada antes de liberar la nueva base." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1430" width="340" height="205" as="geometry" /></mxCell><mxCell id="e0" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="sCOM-R-01" target="COM-R-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="vCOM-R-01" target="COM-R-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="sCOM-R-02" target="COM-R-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="vCOM-R-02" target="COM-R-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="sCOM-R-03" target="COM-R-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="vCOM-R-03" target="COM-R-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="sCOM-R-04" target="COM-R-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="vCOM-R-04" target="COM-R-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="sCOM-R-05" target="COM-R-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="vCOM-R-05" target="COM-R-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="sCOM-R-06" target="COM-R-06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="vCOM-R-06" target="COM-R-06"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="COM-1" name="act [COM] Hilo MBSE–CAD–CAS–CAM"><mxGraphModel dx="1440" dy="1190" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1190" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="act [COM] Hil