<mxfile host="app.diagrams.net" version="24.7.17" compressed="false"><diagram id="AG-0" name="req [AG] Requisitos 1/2"><mxGraphModel dx="1440" dy="1730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1730" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [AG] Requisitos 1/2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="«satisfy» y «verify» expresan intención y plan; fuentes Markdown conservan texto completo y criterios TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="AG-R-01" value="«requirement» AG-R-01&lt;br&gt;Deberá definir ocupación, carga, duración, alcance, emplazamientos y modos operativos. Parámetros: ocupantes [n], carga [kg], autonomía [min], alcance [km]: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="180" width="560" height="225" as="geometry" /></mxCell><mxCell id="s0" value="«block»&lt;br&gt;AG-M-00&lt;br&gt;&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="195" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-01" value="«testCase» AG-V-01: revisión de misión y escenarios&lt;br&gt;CONOPS aprobado con ocupación, carga, duración, alcance y operación agua/tierra definidos.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-02" value="«requirement» AG-R-02&lt;br&gt;Deberá mantener masa y centro de gravedad dentro de límites aprobados en todas las configuraciones y consumos. Parámetros: MTOM [kg], CG [m], márgenes: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="435" width="560" height="225" as="geometry" /></mxCell><mxCell id="s1" value="«block»&lt;br&gt;AG-M-00&lt;br&gt;AG-SIM-MB&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-02" value="«testCase» AG-V-02: análisis y pesaje&lt;br&gt;Masa y CG de cada caso de carga y consumo dentro de límites TBD aprobados; informe y pesaje.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="435" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-03" value="«requirement» AG-R-03&lt;br&gt;Deberá demostrar sustentación, estabilidad y control en la envolvente de giroplano adoptada, incluidas transiciones de despegue y aterrizaje. Velocidad [m/s], RPM, viento y distancias [m]: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="690" width="560" height="225" as="geometry" /></mxCell><mxCell id="s2" value="«block»&lt;br&gt;AG-M-01&lt;br&gt;AG-SIM-RT, AG-SIM-FD&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="705" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-03" value="«testCase» AG-V-03: modelos y ensayos progresivos&lt;br&gt;Envolvente, márgenes y tolerancia de correlación TBD satisfechos; campaña progresiva documentada.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="690" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-04" value="«requirement» AG-R-04&lt;br&gt;Deberá proporcionar empuje y reserva energética para la misión, con supervisión térmica y respuesta definida ante fallos. Potencia [kW], energía, refrigeración y tipo de motor: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="945" width="560" height="225" as="geometry" /></mxCell><mxCell id="s3" value="«block»&lt;br&gt;AG-M-03&lt;br&gt;AG-SIM-EN, AG-SIM-TH&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-04" value="«testCase» AG-V-04: banco y análisis&lt;br&gt;Ciclo de misión y reserva TBD cubiertos sin exceder límites térmicos TBD; curvas de banco y balance.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="945" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-05" value="«requirement» AG-R-05&lt;br&gt;Deberá sostener las condiciones de carga y conservar estabilidad a flote y durante maniobras en la envolvente acuática aprobada. Reserva de flotabilidad, oleaje, calado y estanqueidad: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="1200" width="560" height="225" as="geometry" /></mxCell><mxCell id="s4" value="«block»&lt;br&gt;AG-M-04&lt;br&gt;AG-SIM-HY&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1215" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-05" value="«testCase» AG-V-05: análisis y ensayos acuáticos&lt;br&gt;Estabilidad, reserva de flotabilidad, oleaje y daño definidos TBD satisfechos; balance y ensayos acuáticos.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1200" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-06" value="«requirement» AG-R-06&lt;br&gt;Deberá transmitir cargas de rotor, propulsión y flotadores mediante uniones verificables, considerando fatiga y ambiente húmedo. Cargas, vida, corrosión y materiales: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="1455" width="560" height="225" as="geometry" /></mxCell><mxCell id="s5" value="«block»&lt;br&gt;AG-M-01 / AG-M-02 / AG-M-03&lt;br&gt;AG-SIM-ST&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1470" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-06" value="«testCase» AG-V-06: análisis, inspección y ensayos&lt;br&gt;Casos de carga, márgenes, fatiga y ambiente húmedo acordados TBD satisfechos; análisis e inspección.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1455" width="340" height="225" as="geometry" /></mxCell><mxCell id="e0" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s0" target="AG-R-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="AG-V-01" target="AG-R-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s1" target="AG-R-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="AG-V-02" target="AG-R-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s2" target="AG-R-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="AG-V-03" target="AG-R-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s3" target="AG-R-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="AG-V-04" target="AG-R-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s4" target="AG-R-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="AG-V-05" target="AG-R-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s5" target="AG-R-06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="AG-V-06" target="AG-R-06"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="AG-1" name="req [AG] Requisitos 2/2"><mxGraphModel dx="1440" dy="1730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1730" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [AG] Requisitos 2/2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="«satisfy» y «verify» expresan intención y plan; fuentes Markdown conservan texto completo y criterios TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="AG-R-07" value="«requirement» AG-R-07&lt;br&gt;Deberá permitir acceso, visibilidad, sujeción y evacuación para los ocupantes definidos, incluidos escenarios de emergencia en agua. Ergonomía y tiempos de evacuación: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="180" width="560" height="225" as="geometry" /></mxCell><mxCell id="s0" value="«block»&lt;br&gt;AG-M-02&lt;br&gt;&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="195" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-07" value="«testCase» AG-V-07: maqueta y demostración&lt;br&gt;Población y escenarios definidos; acceso, visibilidad y evacuación cumplen criterios TBD; demostración.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-08" value="«requirement» AG-R-08&lt;br&gt;Deberá permitir mando y supervisión de vuelo, propulsión y condición anfibia, con indicaciones inequívocas y modos degradados definidos. Sensores, alimentación, alertas y latencia: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="435" width="560" height="225" as="geometry" /></mxCell><mxCell id="s1" value="«block»&lt;br&gt;AG-M-05&lt;br&gt;AG-SIM-CT&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-08" value="«testCase» AG-V-08: integración y fallos simulados&lt;br&gt;Latencias, alertas y respuestas degradadas TBD cumplidas en integración y fallos simulados.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="435" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-09" value="«requirement» AG-R-09&lt;br&gt;Deberá permitir sustitución de módulos con interfaces documentadas, configuración identificable e inspección posterior. Tiempo de intervención y medios: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="690" width="560" height="225" as="geometry" /></mxCell><mxCell id="s2" value="«block»&lt;br&gt;AG-M-00&lt;br&gt;AG-SIM-MB&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="705" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-09" value="«testCase» AG-V-09: inspección y demostración&lt;br&gt;ICD y configuración identificados; sustitución dentro de tiempo TBD con inspección funcional conforme.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="690" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-10" value="«requirement» AG-R-10&lt;br&gt;Deberá trazar peligros a medidas y evidencias: pérdida de empuje, entrada de agua, inestabilidad, contacto con hélice/rotor y evacuación. Base de conformidad: D-02, pendiente.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="945" width="560" height="225" as="geometry" /></mxCell><mxCell id="s3" value="«block»&lt;br&gt;AG-M-00&lt;br&gt;&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-10" value="«testCase» AG-V-10: revisión de riesgos y evidencias&lt;br&gt;AG-D-02 resuelta; peligros trazados y tratamiento de riesgos residuales revisado según proceso acordado.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="945" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-11" value="«requirement» AG-R-11&lt;br&gt;Deberá mantener modelos de masa, vuelo, estructura y flotación vinculados a una configuración y datos de validación trazables. Fidelidad, incertidumbre y frecuencia de actualización: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="1200" width="560" height="225" as="geometry" /></mxCell><mxCell id="s4" value="«block»&lt;br&gt;AG-M-06&lt;br&gt;AG-SIM-MB, AG-SIM-RT, AG-SIM-FD, AG-SIM-ST, AG-SIM-HY&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1215" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-11" value="«testCase» AG-V-11: correlación y reproducibilidad&lt;br&gt;Error y dominio TBD cumplidos con modelos versionados y datos separados para calibración/validación.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1200" width="340" height="225" as="geometry" /></mxCell><mxCell id="AG-R-12" value="«requirement» AG-R-12&lt;br&gt;Si D-03 incluye tierra, deberá incorporar una solución de apoyo, frenado y transición compatible con flotadores y centrado. Tren, terreno y cargas de aterrizaje: TBD.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/amphibious-gyroplane.md"><mxGeometry x="420" y="1455" width="560" height="225" as="geometry" /></mxCell><mxCell id="s5" value="«block»&lt;br&gt;AG-M-04&lt;br&gt;AG-SIM-ST, AG-SIM-HY&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1470" width="300" height="195" as="geometry" /></mxCell><mxCell id="AG-V-12" value="«testCase» AG-V-12: análisis y demostración&lt;br&gt;AG-D-03 cerrada; si aplica tierra, apoyo, frenado y transición cumplen cargas y escenarios TBD.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1455" width="340" height="225" as="geometry" /></mxCell><mxCell id="e0" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s0" target="AG-R-07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="AG-V-07" target="AG-R-07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s1" target="AG-R-08"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="AG-V-08" target="AG-R-08"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=