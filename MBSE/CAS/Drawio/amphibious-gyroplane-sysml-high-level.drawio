Cell><mxCell id="pa5" value="" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#ffffff;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="405" y="1225" width="14" height="24" as="geometry" /></mxCell><mxCell id="pb5" value="" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#ffffff;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1022" y="1225" width="14" height="24" as="geometry" /></mxCell><mxCell id="e0" value="AG-IF-01: cargas y movimiento · «itemFlow»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="pa0" target="pb0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="AG-IF-02: ocupantes y anclajes · «itemFlow»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="pa1" target="pb1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="AG-IF-03: empuje, energía y mando · «itemFlow»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="pa2" target="pb2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="AG-IF-04: cargas, agua y tren TBD · «itemFlow»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="pa3" target="pb3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="AG-IF-05: señales y supervisión · «itemFlow»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="pa4" target="pb4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="AG-IF-06: configuración y datos · «itemFlow»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="pa5" target="pb5"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="AG-4" name="act [AG] Misión y revisiones"><mxGraphModel dx="1440" dy="1215" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1215" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="act [AG] Misión y revisiones" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="Actividad de misión propuesta. AG no presupone tren terrestre; HG no presupone VTOL; EV no presupone tolerancia a pérdida de rotor." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="a0" value="Aprobar misión y AG-D-03" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="180" width="580" height="85" as="geometry" /></mxCell><mxCell id="a1" value="Inspección y carga" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="330" width="580" height="85" as="geometry" /></mxCell><mxCell id="a2" value="Maniobra acuática / apoyo terrestre si aplica" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="480" width="580" height="85" as="geometry" /></mxCell><mxCell id="a3" value="Prerrotación si AG-D-05 la confirma" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="630" width="580" height="85" as="geometry" /></mxCell><mxCell id="a4" value="Despegue y vuelo en envolvente" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="780" width="580" height="85" as="geometry" /></mxCell><mxCell id="a5" value="Aterrizaje y evaluación de flotación" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="930" width="580" height="85" as="geometry" /></mxCell><mxCell id="a6" value="Inspección y mantenimiento" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="440" y="1080" width="580" height="85" as="geometry" /></mxCell><mxCell id="gate" value="«constraint»&lt;br&gt;Bloqueo: TBD críticos, ICD o datos insuficientes&lt;br&gt;Respuesta degradada debe definirse antes de operar" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="320" height="200" as="geometry" /></mxCell><mxCell id="e0" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="flujo de control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=block;endFill=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="AG-5" name="par [AG] Restricciones y binding connectors"><mxGraphModel dx="1440" dy="2105" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="2105" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="par [AG] Restricciones y binding connectors" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="Bindings sin flecha representan igualdad de valores, no dirección causal. Ecuaciones de cribado; detalles y dominio en docs/simulation." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="iMB" value="«valueProperty»&lt;br&gt;m_i [kg], r_i [m], inercia J [kg m²]; configuración y estados de consumo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="340" height="195" as="geometry" /></mxCell><mxCell id="cMB" value="«constraintProperty» AG-SIM-MB&lt;br&gt;Masa y centrado&lt;br&gt;m = Σ m_i; r_CG = Σ(m_i r_i)/m" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="180" width="520" height="195" as="geometry" /></mxCell><mxCell id="oMB" value="«valueProperty»&lt;br&gt;m [kg], CG [m], J [kg m²]&lt;br&gt;Pesaje y medición de CG independientes; incertidumbre de masas y posiciones; límites TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="195" as="geometry" /></mxCell><mxCell id="iRT" value="«valueProperty»&lt;br&gt;Ω [rad/s], par [N m], geometría, polar y régimen TBC" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="340" height="195" as="geometry" /></mxCell><mxCell id="cRT" value="«constraintProperty» AG-SIM-RT&lt;br&gt;Rotor / propulsor&lt;br&gt;J_r dΩ/dt = Q_drive + Q_aero − Q_loss; T,Q = mapas(Ω,V,ρ,paso)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="420" width="520" height="195" as="geometry" /></mxCell><mxCell id="oRT" value="«valueProperty»&lt;br&gt;T [N], Q [N m], potencia QΩ [W]&lt;br&gt;Autorrotación: Q_drive=0 tras prerrotación; equilibrio estable de par por demostrar; no usar estacionario motorizado como prueba de AG." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="420" width="340" height="195" as="geometry" /></mxCell><mxCell id="iFD" value="«valueProperty»&lt;br&gt;F [N], M [N m], viento [m/s], actitud, v [m/s], J; masas congeladas por segmento" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="340" height="195" as="geometry" /></mxCell><mxCell id="cFD" value="«constraintProperty» AG-SIM-FD&lt;br&gt;Dinámica 6-DOF&lt;br&gt;m dv_I/dt = m g_I + R_BI F_B; J dω/dt = M_B − ω × (Jω)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="660" width="520" height="195" as="geometry" /></mxCell><mxCell id="oFD" value="«valueProperty»&lt;br&gt;Trayectorias, aceleración, márgenes y cargas&lt;br&gt;Cuerpo rígido y marco inercial; rotación y cinemática de actitud separadas; validar fuerzas y transición." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="660" width="340" height="195" as="geometry" /></mxCell><mxCell id="iEN" value="«valueProperty»&lt;br&gt;E_b [J], potencias [W], eficiencias y límites; P_b&amp;gt;0 descarga, P_b&amp;lt;0 carga" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="340" height="195" as="geometry" /></mxCell><mxCell id="cEN" value="«constraintProperty» AG-SIM-EN&lt;br&gt;Potencia y energía&lt;br&gt;dE_b/dt = −P_b; P_gen + P_b = P_load + P_loss" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="900" width="520" height="195" as="geometry" /></mxCell><mxCell id="oEN" value="«valueProperty»&lt;br&gt;Energía, potencia, reserva y consumo&lt;br&gt;Topología y mapas TBD; pérdidas no negativas; energía y temperatura correlacionadas con banco." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="900" width="340" height="195" as="geometry" /></mxCell><mxCell id="iTH" value="«valueProperty»&lt;br&gt;C_th [J/K], T [K], hA [W/K], pérdidas [W]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1140" width="340" height="195" as="geometry" /></mxCell><mxCell id="cTH" value="«constraintProperty» AG-SIM-TH&lt;br&gt;Temperatura equivalente&lt;br&gt;C_th dT/dt = P_heat − hA(T − T_amb)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1140" width="520" height="195" as="geometry" /></mxCell><mxCell id="oTH" value="«valueProperty»&lt;br&gt;Temperatura y margen al límite&lt;br&gt;Modelo térmico concentrado; gradientes, fugas térmicas y propagación fuera de alcance inicial." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1140" width="340" height="195" as="geometry" /></mxCell><mxCell id="iST" value="«valueProperty»&lt;br&gt;M,C,K, propiedades, apoyos, malla y cargas [N]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1380" width="340" height="195" as="geometry" /></mxCell><mxCell id="cST" value="«constraintProperty» AG-SIM-ST&lt;br&gt;Estructura y uniones&lt;br&gt;M_s ü + C_s u̇ + K_s u = f(t)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1380" width="520" height="195" as="geometry" /></mxCell><mxCell id="oST" value="«valueProperty»&lt;br&gt;Desplazamiento [m], tensiones [Pa], reacciones&lt;br&gt;Lineal elástico de cribado; grandes deformaciones, contacto, fatiga y corrosión requieren modelos adicionales." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1380" width="340" height="195" as="geometry" /></mxCell><mxCell id="iHY" value="«valueProperty»&lt;br&gt;Volumen sumergido ∇ [m³], CG/CB, plano de agua, GM [m], φ [rad]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1620" width="340" height="195" as="geometry" /></mxCell><mxCell id="cHY" value="«constraintProperty» AG-SIM-HY&lt;br&gt;Flotación / maniobras&lt;br&gt;B = ρ_w g ∇; en equilibrio B = mg; M_restore ≈ −mg GM φ" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1620" width="520" height="195" as="geometry" /></mxCell><mxCell id="oHY" value="«valueProperty»&lt;br&gt;Calado, reserva de flotabilidad y estabilidad&lt;br&gt;Pequeños ángulos en agua calma; GM depende de geometría; oleaje, daño, planeo y slamming exigen otros modelos." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1620" width="340" height="195" as="geometry" /></mxCell><mxCell id="iCT" value="«valueProperty»&lt;br&gt;Período [s], ruido, latencia, saturación y fallos TBD" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1860" width="340" height="195" as="geometry" /></mxCell><mxCell id="cCT" value="«constraintProperty» AG-SIM-CT&lt;br&gt;Control / sensado&lt;br&gt;y_k = h(x_k) + ε_k; u_k = control(y,modo,referencia)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1860" width="520" height="195" as="geometry" /></mxCell><mxCell id="oCT" value="«valueProperty»&lt;br&gt;Error de seguimiento, detección y respue