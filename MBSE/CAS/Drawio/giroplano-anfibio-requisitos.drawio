<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="31.4.2" type="device">
  <diagram id="p0" name="01 · Requisitos de alto nivel">
    <mxGraphModel dx="1800" dy="1510" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1510" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="GIROPLANO ANFIBIO MODULAR | Ingeniería de requisitos&#10;Especificación conceptual de alto nivel · Basada en la imagen suministrada · Revisión A" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=23;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="30" width="1720" height="85" />
        </mxCell>
        <mxCell id="scope" value="BASE DEL CONCEPTO&#10;Observado: rotor, cabina con dos asientos aparentes, hélice posterior, cola y dos flotadores.&#10;Hipótesis a confirmar: configuración de giroplano con rotor en autorrotación. No se deducen dimensiones, prestaciones ni certificación de una imagen." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="140" width="835" height="130" />
        </mxCell>
        <mxCell id="decisions" value="DECISIONES DE ALCANCE ABIERTAS&#10;D-01: misión, ocupación y carga útil. D-02: jurisdicción y categoría aplicable.&#10;D-03: operación terrestre y solución de tren (no visible). D-04: tipo de energía y motor.&#10;TBD = por definir; TBC = por confirmar. Todo requisito es propuesto." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="905" y="140" width="855" height="130" />
        </mxCell>
        <mxCell id="sys" value="SYS-00 · SISTEMA DE INTERÉS&#10;El sistema deberá permitir la misión aprobada en agua y, si se confirma D-03, en tierra, integrando vuelo, flotación, control y mantenimiento modular dentro de una envolvente demostrada." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=18;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="470" y="305" width="860" height="105" />
        </mxCell>
        <mxCell id="req1" value="R-01 · MISIÓN Y OPERACIÓN&#10;Deberá definir ocupación, carga, duración, alcance, emplazamientos y modos operativos.&#10;Parámetros: ocupantes [n], carga [kg], autonomía [min], alcance [km]: TBD.&#10;Verificación: V-01 · revisión de misión y escenarios." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="460" width="560" height="205" />
        </mxCell>
        <mxCell id="req2" value="R-02 · MASA Y CENTRADO&#10;Deberá mantener masa y centro de gravedad dentro de límites aprobados en todas las configuraciones y consumos.&#10;Parámetros: MTOM [kg], CG [m], márgenes: TBD.&#10;Verificación: V-02 · análisis y pesaje." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="460" width="560" height="205" />
        </mxCell>
        <mxCell id="req3" value="R-03 · ROTOR Y VUELO&#10;Deberá demostrar sustentación, estabilidad y control en la envolvente de giroplano adoptada, incluidas transiciones de despegue y aterrizaje.&#10;Velocidad [m/s], RPM, viento y distancias [m]: TBD.&#10;Verificación: V-03 · modelos y ensayos progresivos." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="460" width="560" height="205" />
        </mxCell>
        <mxCell id="req4" value="R-04 · PROPULSIÓN Y ENERGÍA&#10;Deberá proporcionar empuje y reserva energética para la misión, con supervisión térmica y respuesta definida ante fallos.&#10;Potencia [kW], energía, refrigeración y tipo de motor: TBD.&#10;Verificación: V-04 · banco y análisis." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="685" width="560" height="205" />
        </mxCell>
        <mxCell id="req5" value="R-05 · FLOTACIÓN E HIDRODINÁMICA&#10;Deberá sostener las condiciones de carga y conservar estabilidad a flote y durante maniobras en la envolvente acuática aprobada.&#10;Reserva de flotabilidad, oleaje, calado y estanqueidad: TBD.&#10;Verificación: V-05 · análisis y ensayos acuáticos." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="685" width="560" height="205" />
        </mxCell>
        <mxCell id="req6" value="R-06 · ESTRUCTURA Y MATERIALES&#10;Deberá transmitir cargas de rotor, propulsión y flotadores mediante uniones verificables, considerando fatiga y ambiente húmedo.&#10;Cargas, vida, corrosión y materiales: TBD.&#10;Verificación: V-06 · análisis, inspección y ensayos." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="685" width="560" height="205" />
        </mxCell>
        <mxCell id="req7" value="R-07 · CABINA Y FACTORES HUMANOS&#10;Deberá permitir acceso, visibilidad, sujeción y evacuación para los ocupantes definidos, incluidos escenarios de emergencia en agua.&#10;Ergonomía y tiempos de evacuación: TBD.&#10;Verificación: V-07 · maqueta y demostración." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="910" width="560" height="205" />
        </mxCell>
        <mxCell id="req8" value="R-08 · CONTROL Y AVIÓNICA&#10;Deberá permitir mando y supervisión de vuelo, propulsión y condición anfibia, con indicaciones inequívocas y modos degradados definidos.&#10;Sensores, alimentación, alertas y latencia: TBD.&#10;Verificación: V-08 · integración y fallos simulados." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="910" width="560" height="205" />
        </mxCell>
        <mxCell id="req9" value="R-09 · MODULARIDAD Y MANTENIMIENTO&#10;Deberá permitir sustitución de módulos con interfaces documentadas, configuración identificable e inspección posterior.&#10;Tiempo de intervención y medios: TBD.&#10;Verificación: V-09 · inspección y demostración." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="910" width="560" height="205" />
        </mxCell>
        <mxCell id="req10" value="R-10 · SEGURIDAD Y CONFORMIDAD&#10;Deberá trazar peligros a medidas y evidencias: pérdida de empuje, entrada de agua, inestabilidad, contacto con hélice/rotor y evacuación.&#10;Base de conformidad: D-02, pendiente.&#10;Verificación: V-10 · revisión de riesgos y evidencias." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1135" width="560" height="205" />
        </mxCell>
        <mxCell id="req11" value="R-11 · GEMELA DIGITAL&#10;Deberá mantener modelos de masa, vuelo, estructura y flotación vinculados a una configuración y datos de validación trazables.&#10;Fidelidad, incertidumbre y frecuencia de actualización: TBD.&#10;Verificación: V-11 · correlación y reproducibilidad." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAF3F2;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1135" width="560" height="205" />
        </mxCell>
        <mxCell id="req12" value="R-12 · OPERACIÓN ANFIBIA TERRESTRE&#10;Si D-03 incluye tierra, deberá incorporar una solución de apoyo, frenado y transición compatible con flotadores y centrado.&#10;Tren, terreno y cargas de aterrizaje: TBD.&#10;Verificación: V-12 · análisis y demostración." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EAF4FC;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="1135" width="560" height="205" />
        </mxCell>
        <mxCell id="decomp0" value="derivar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sys" target="req1">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="decomp1" value="derivar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sys" target="req2">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="decomp2" value="derivar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#4D7892;fontSize=12;labelBackgroundColor=#FFFFFF;dashed=0;" edge="1" parent="1" source="sys" target="req3">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="legend" value="LECTURA: R-xx = requisito propuesto · V-xx = método de verificación (pestaña 03) · Las tarjetas R-01 a R-12 descomponen SYS-00.&#10;Los valores TBD deben fijarse con responsables y evidencia antes de congelar requisitos. No constituye un diseño de fabricación ni una validación de aeronavegabilidad." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=15;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1390" width="1720" height="80" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
