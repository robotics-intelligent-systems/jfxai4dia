        <mxCell id="title" value="VERIFICACIÓN Y CIERRE DE REQUISITOS&#10;Matriz de trazabilidad propuesta · Los ensayos y criterios indicados son trabajo futuro." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=23;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
