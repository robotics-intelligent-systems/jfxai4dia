        <mxCell id="h2" value="Evidencia de aceptación" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="570" y="140" width="550" height="60" />
        </mxCell>
        <mxCell id="h3" value="Criterio de cierre / parámetro pendiente" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#12324A;strokeColor=#6D8CA3;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=1;" vertex="1" parent="1">
