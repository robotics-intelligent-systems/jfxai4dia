        <mxCell id="tools" value="CADENA DE HERRAMIENTAS PROPUESTA&#10;FreeCAD: geometría e interfaces · Blender: visualización&#10;OpenModelica: modelos de sistemas · OpenFOAM: análisis de fluidos&#10;Project Chrono: dinámica multicuerpo&#10;Intercambio mediante formatos y adaptadores verificados; compatibilidad no asumida." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#DAF3F2;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="855" width="790" height="190" />
        </mxCell>
        <mxCell id="evidence" value="EVIDENCIA Y CONFIGURACIÓN&#10;Revisión CAD + parámetros + masa/CG + modelos + datos de ensayo&#10;Versiones, unidades, hipótesis y márgenes registrados por ejecución.&#10;La IA puede asistir en análisis y documentación; las decisiones se basan en evidencia validada.&#10;Código abierto propuesto ≠ modelos implementados o validados." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF3D8;strokeColor=#6D8CA3;fontColor=#18354A;fontSize=17;fontFamily=Helvetica;align=left;verticalAlign=middle;spacing=14;fontStyle=0;" vertex="1" parent="1">
