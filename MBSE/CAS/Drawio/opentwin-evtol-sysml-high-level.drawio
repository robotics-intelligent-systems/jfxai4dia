Height="1865" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="par [EV] Restricciones y binding connectors" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="Bindings sin flecha representan igualdad de valores, no dirección causal. Ecuaciones de cribado; detalles y dominio en docs/simulation." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="iMB" value="«valueProperty»&lt;br&gt;m_i [kg], r_i [m], inercia J [kg m²]; configuración y estados de consumo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="180" width="340" height="195" as="geometry" /></mxCell><mxCell id="cMB" value="«constraintProperty» EV-SIM-MB&lt;br&gt;Masa y centrado&lt;br&gt;m = Σ m_i; r_CG = Σ(m_i r_i)/m" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="180" width="520" height="195" as="geometry" /></mxCell><mxCell id="oMB" value="«valueProperty»&lt;br&gt;m [kg], CG [m], J [kg m²]&lt;br&gt;Pesaje y medición de CG independientes; incertidumbre de masas y posiciones; límites TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="195" as="geometry" /></mxCell><mxCell id="iMC" value="«valueProperty»&lt;br&gt;Geometría de rotores, Ω_i [rad/s], T_i [N], A_i [m²]; B_alloc con brazos y par" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="340" height="195" as="geometry" /></mxCell><mxCell id="cMC" value="«constraintProperty» EV-SIM-MC&lt;br&gt;Multicóptero / asignación&lt;br&gt;wrench = B_alloc f; T_i = mapas_i(Ω_i,V); P_ideal = T_i^(3/2)/√(2ρ A_i)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="420" width="520" height="195" as="geometry" /></mxCell><mxCell id="oMC" value="«valueProperty»&lt;br&gt;Empuje, momento, potencia y factibilidad de mando&lt;br&gt;Potencia ideal sólo disco aislado en hover fuera de efecto suelo; no demuestra pérdidas, interacción ni tolerancia a fallo." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="420" width="340" height="195" as="geometry" /></mxCell><mxCell id="iFD" value="«valueProperty»&lt;br&gt;F [N], M [N m], viento [m/s], actitud, v [m/s], J; masas congeladas por segmento" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="660" width="340" height="195" as="geometry" /></mxCell><mxCell id="cFD" value="«constraintProperty» EV-SIM-FD&lt;br&gt;Dinámica 6-DOF&lt;br&gt;m dv_I/dt = m g_I + R_BI F_B; J dω/dt = M_B − ω × (Jω)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="660" width="520" height="195" as="geometry" /></mxCell><mxCell id="oFD" value="«valueProperty»&lt;br&gt;Trayectorias, aceleración, márgenes y cargas&lt;br&gt;Cuerpo rígido y marco inercial; rotación y cinemática de actitud separadas; validar fuerzas y transición." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="660" width="340" height="195" as="geometry" /></mxCell><mxCell id="iEN" value="«valueProperty»&lt;br&gt;E_b [J], potencias [W], eficiencias y límites; P_b&amp;gt;0 descarga, P_b&amp;lt;0 carga" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="900" width="340" height="195" as="geometry" /></mxCell><mxCell id="cEN" value="«constraintProperty» EV-SIM-EN&lt;br&gt;Potencia y energía&lt;br&gt;dE_b/dt = −P_b; P_gen + P_b = P_load + P_loss" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="900" width="520" height="195" as="geometry" /></mxCell><mxCell id="oEN" value="«valueProperty»&lt;br&gt;Energía, potencia, reserva y consumo&lt;br&gt;Topología y mapas TBD; pérdidas no negativas; energía y temperatura correlacionadas con banco." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="900" width="340" height="195" as="geometry" /></mxCell><mxCell id="iTH" value="«valueProperty»&lt;br&gt;C_th [J/K], T [K], hA [W/K], pérdidas [W]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1140" width="340" height="195" as="geometry" /></mxCell><mxCell id="cTH" value="«constraintProperty» EV-SIM-TH&lt;br&gt;Temperatura equivalente&lt;br&gt;C_th dT/dt = P_heat − hA(T − T_amb)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1140" width="520" height="195" as="geometry" /></mxCell><mxCell id="oTH" value="«valueProperty»&lt;br&gt;Temperatura y margen al límite&lt;br&gt;Modelo térmico concentrado; gradientes, fugas térmicas y propagación fuera de alcance inicial." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1140" width="340" height="195" as="geometry" /></mxCell><mxCell id="iST" value="«valueProperty»&lt;br&gt;M,C,K, propiedades, apoyos, malla y cargas [N]" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1380" width="340" height="195" as="geometry" /></mxCell><mxCell id="cST" value="«constraintProperty» EV-SIM-ST&lt;br&gt;Estructura y uniones&lt;br&gt;M_s ü + C_s u̇ + K_s u = f(t)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1380" width="520" height="195" as="geometry" /></mxCell><mxCell id="oST" value="«valueProperty»&lt;br&gt;Desplazamiento [m], tensiones [Pa], reacciones&lt;br&gt;Lineal elástico de cribado; grandes deformaciones, contacto, fatiga y corrosión requieren modelos adicionales." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1380" width="340" height="195" as="geometry" /></mxCell><mxCell id="iCT" value="«valueProperty»&lt;br&gt;Período [s], ruido, latencia, saturación y fallos TBD" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1620" width="340" height="195" as="geometry" /></mxCell><mxCell id="cCT" value="«constraintProperty» EV-SIM-CT&lt;br&gt;Control / sensado&lt;br&gt;y_k = h(x_k) + ε_k; u_k = control(y,modo,referencia)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#e1d5e7;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="460" y="1620" width="520" height="195" as="geometry" /></mxCell><mxCell id="oCT" value="«valueProperty»&lt;br&gt;Error de seguimiento, detección y respuesta degradada&lt;br&gt;Ley de control y modos por diseñar; gemela y telemetría de ingeniería sin autoridad de vuelo." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1620" width="340" height="195" as="geometry" /></mxCell><mxCell id="e0" value="binding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=none;startArrow=none;" edge="1" parent="1" source="iMB" target="cMB"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="binding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=none;startArrow=none;" edge="1" parent="1" source="cMB" target="oMB"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="binding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;endArrow=none;sta