<mxfile host="app.diagrams.net" version="24.7.17" compressed="false"><diagram id="EV-0" name="req [EV] Requisitos 1/2"><mxGraphModel dx="1440" dy="1730" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1730" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [EV] Requisitos 1/2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="«satisfy» y «verify» expresan intención y plan; fuentes Markdown conservan texto completo y criterios TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="EV-R-01" value="«requirement» EV-R-01&lt;br&gt;El sistema deberá completar la misión personal aprobada de despegue, estacionario, desplazamiento y aterrizaje con reserva definida.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="180" width="560" height="225" as="geometry" /></mxCell><mxCell id="s0" value="«block»&lt;br&gt;EV-M-00&lt;br&gt;&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="195" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-01" value="«testCase» EV-V-01: Sistemas / revisión&lt;br&gt;Ocupación TBC, carga [kg], duración [min], radio [km], viento [m/s] y reserva TBD definidos en CONOPS.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="225" as="geometry" /></mxCell><mxCell id="EV-R-02" value="«requirement» EV-R-02&lt;br&gt;Cada configuración y estado energético deberá mantenerse dentro de masa y CG aprobados.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="435" width="560" height="225" as="geometry" /></mxCell><mxCell id="s1" value="«block»&lt;br&gt;EV-M-00&lt;br&gt;EV-SIM-MB&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-02" value="«testCase» EV-V-02: Integración / análisis y pesaje&lt;br&gt;MTOM [kg] y límites CG [m] TBD cumplidos con ocupante, batería y módulos; informe y pesaje.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="435" width="340" height="225" as="geometry" /></mxCell><mxCell id="EV-R-03" value="«requirement» EV-R-03&lt;br&gt;La propulsión distribuida deberá proporcionar sustentación y autoridad de control para los segmentos y estados degradados seleccionados.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="690" width="560" height="225" as="geometry" /></mxCell><mxCell id="s2" value="«block»&lt;br&gt;EV-M-02&lt;br&gt;EV-SIM-MC, EV-SIM-FD&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="705" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-03" value="«testCase» EV-V-03: Dinámica y propulsión / banco y análisis&lt;br&gt;Número de rotores TBC, empuje [N], márgenes, envolvente y fallos TBD definidos y satisfechos; interacción entre rotores evaluada.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="690" width="340" height="225" as="geometry" /></mxCell><mxCell id="EV-R-04" value="«requirement» EV-R-04&lt;br&gt;La batería y distribución deberán cubrir misión y reserva dentro de sus límites eléctricos, térmicos y de estado energético.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="945" width="560" height="225" as="geometry" /></mxCell><mxCell id="s3" value="«block»&lt;br&gt;EV-M-03&lt;br&gt;EV-SIM-EN, EV-SIM-TH&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-04" value="«testCase» EV-V-04: Energía / banco y análisis&lt;br&gt;Potencia [kW], energía utilizable [kWh], tensión [V], corriente [A], temperatura [K] y estado de carga [%] TBD cumplidos en ciclo de misión.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="945" width="340" height="225" as="geometry" /></mxCell><mxCell id="EV-R-05" value="«requirement» EV-R-05&lt;br&gt;El control deberá detectar las condiciones de fallo definidas y producir mando, alertas y respuesta degradada conforme a la arquitectura seleccionada.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="1200" width="560" height="225" as="geometry" /></mxCell><mxCell id="s4" value="«block»&lt;br&gt;EV-M-04&lt;br&gt;EV-SIM-CT&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1215" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-05" value="«testCase» EV-V-05: Control / integración y fallos simulados&lt;br&gt;Latencias [ms], disponibilidad, pérdida de sensor/comunicación/actuador y respuesta TBD satisfechas; registros sincronizados.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1200" width="340" height="225" as="geometry" /></mxCell><mxCell id="EV-R-06" value="«requirement» EV-R-06&lt;br&gt;Cabina, brazos, uniones y patines deberán transmitir cargas de propulsión, ocupante y aterrizaje aprobadas.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="1455" width="560" height="225" as="geometry" /></mxCell><mxCell id="s5" value="«block»&lt;br&gt;EV-M-01&lt;br&gt;EV-SIM-ST&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="1470" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-06" value="«testCase» EV-V-06: Estructuras / análisis y ensayo&lt;br&gt;Cargas [N], momentos [N m], impacto, vida y márgenes TBD satisfechos; asignación compartida con EV-M-05.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="1455" width="340" height="225" as="geometry" /></mxCell><mxCell id="e0" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s0" target="EV-R-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="EV-V-01" target="EV-R-01"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s1" target="EV-R-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="EV-V-02" target="EV-R-02"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s2" target="EV-R-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="EV-V-03" target="EV-R-03"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s3" target="EV-R-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="EV-V-04" target="EV-R-04"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s4" target="EV-R-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="EV-V-05" target="EV-R-05"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s5" target="EV-R-06"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="EV-V-06" target="EV-R-06"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="EV-1" name="req [EV] Requisitos 2/2"><mxGraphModel dx="1440" dy="1220" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1220" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="req [EV] Requisitos 2/2" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#16324f;strokeColor=#536878;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1380" height="48" as="geometry" /></mxCell><mxCell id="note" value="«satisfy» y «verify» expresan intención y plan; fuentes Markdown conservan texto completo y criterios TBD." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1380" height="65" as="geometry" /></mxCell><mxCell id="EV-R-07" value="«requirement» EV-R-07&lt;br&gt;La cabina abierta deberá permitir sujeción, acceso, visibilidad y evacuación dentro del entorno de operación aprobado.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="180" width="560" height="225" as="geometry" /></mxCell><mxCell id="s0" value="«block»&lt;br&gt;EV-M-01&lt;br&gt;&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="195" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-07" value="«testCase» EV-V-07: Factores humanos / demostración&lt;br&gt;Población, exposición ambiental, separación de rotores y tiempo de evacuación [s] TBD evaluados en maqueta.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="180" width="340" height="225" as="geometry" /></mxCell><mxCell id="EV-R-08" value="«requirement» EV-R-08&lt;br&gt;La sustitución de energía, propulsión o control deberá conservar compatibilidad, identificación y funcionamiento de la configuración.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="435" width="560" height="225" as="geometry" /></mxCell><mxCell id="s1" value="«block»&lt;br&gt;EV-M-00&lt;br&gt;EV-SIM-MB&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="450" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-08" value="«testCase» EV-V-08: Mantenimiento / inspección y demostración&lt;br&gt;ICD, tiempo [min] y herramientas TBD definidos; inspección y prueba posteriores conformes; impacto masa/CG evaluado.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="435" width="340" height="225" as="geometry" /></mxCell><mxCell id="EV-R-09" value="«requirement» EV-R-09&lt;br&gt;Los peligros de pérdida de sustentación, fallos eléctricos/térmicos y contacto con rotores deberán vincularse a requisitos y evidencias de mitigación.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="690" width="560" height="225" as="geometry" /></mxCell><mxCell id="s2" value="«block»&lt;br&gt;EV-M-00&lt;br&gt;EV-SIM-CT, EV-SIM-TH&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="705" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-09" value="«testCase» EV-V-09: Seguridad / revisión&lt;br&gt;Escenarios, criterios de riesgo y respuestas TBD revisados; no se presume tolerancia a fallo de un rotor.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="690" width="340" height="225" as="geometry" /></mxCell><mxCell id="EV-R-10" value="«requirement» EV-R-10&lt;br&gt;La gemela deberá vincular geometría, energía, estructura, dinámica y telemetría a una revisión de configuración.&lt;br&gt;Estado: propuesto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#fff2cc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1" link="https://github.com/robotics-intelligent-systems/jfxai4dia/blob/main/docs/requirements/concepts/opentwin-evtol.md"><mxGeometry x="420" y="945" width="560" height="225" as="geometry" /></mxCell><mxCell id="s3" value="«block»&lt;br&gt;EV-M-06&lt;br&gt;EV-SIM-MB, EV-SIM-MC, EV-SIM-FD, EV-SIM-EN, EV-SIM-ST&lt;br&gt;Asignación candidata" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#dae8fc;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="30" y="960" width="300" height="195" as="geometry" /></mxCell><mxCell id="EV-V-10" value="«testCase» EV-V-10: Modelado / correlación y reproducción&lt;br&gt;Error, incertidumbre, sincronización [ms] y dominio TBD satisfechos; calibración separada de validación.&lt;br&gt;No ejecutado" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=15;fillColor=#d5e8d4;strokeColor=#536878;fontColor=#162635;" vertex="1" parent="1"><mxGeometry x="1070" y="945" width="340" height="225" as="geometry" /></mxCell><mxCell id="e0" value="«satisfy»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="s0" target="EV-R-07"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="«verify»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#536878;dashed=1;endArrow=open;" edge="1" parent="1" source="EV-V-07" target="EV-R-07"><mxGeometry relative